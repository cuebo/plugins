{
  "id": "github",
  "name": "GitHub",
  "description": "查看个人概览、贡献日历和仓库概览卡片，以及管理 Issue 与 Pull Request。",
  "pe": "GitHub 插件已启用。用户问我的 GitHub 主页、个人数据、粉丝、Stars、贡献或活跃度时，优先调用 plugin_github_profile_card，实际展示个人卡片；问某个仓库怎么样，或问仓库的 Stars、语言、许可证、分支、标签、更新时间、提交热力图时，调用 plugin_github_repo_card，实际展示仓库卡片。用户给出 owner/repo 或 GitHub 仓库链接时据此填写 owner 和 repo；目标不明确时先用 plugin_github_repos 查找，不猜仓库名。用户只要求列出仓库时调用 plugin_github_repos。除非用户明确只要文字，概览查询不要仅文字描述，卡片工具返回 shown:true 后再简短解读。Issue 和 Pull Request 查询用对应读取工具，写操作仅在用户要求时执行并遵守 App 确认。只使用实测数据，不泄漏令牌。",
  "version": "1.4.1",
  "uiProtocol": "cuebo-v1",
  "capabilities": ["generative_ui"],
  "files": {
    "main.js": ""
  },
  "networkHosts": [
    "api.github.com"
  ],
  "config": [
    {
      "id": "token",
      "title": "GitHub 访问令牌",
      "type": "secret",
      "required": true
    }
  ],
  "tools": [
    {
      "name": "profile_card",
      "description": "查询并展示当前 GitHub 账号的个人卡片：头像、粉丝、Stars、公开仓库、语言和今年贡献热力图。适用于我的 GitHub 主页、贡献、开发者概览等请求。",
      "parameters": {}
    },
    {
      "name": "repo_card",
      "description": "查询并展示指定 GitHub 仓库卡片：简介、Stars、语言、许可证、分支、标签、更新时间和近一年提交热力图。适用于仓库概览、活跃度、提交情况等请求。",
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        }
      }
    },
    {
      "name": "repos",
      "description": "列出当前 GitHub 账号可访问的仓库。",
      "parameters": {
        "page": {
          "type": "number",
          "description": "页码，默认 1。"
        }
      }
    },
    {
      "name": "issues",
      "description": "列出指定仓库的 Issue。",
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "state": {
          "type": "string",
          "description": "open、closed 或 all；默认 open。"
        }
      }
    },
    {
      "name": "issue",
      "description": "查看指定 Issue 详情。",
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "number": {
          "type": "number",
          "description": "Issue 或 Pull Request 编号。",
          "required": true
        }
      }
    },
    {
      "name": "pulls",
      "description": "列出指定仓库的 Pull Request。",
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "state": {
          "type": "string",
          "description": "open、closed 或 all；默认 open。"
        }
      }
    },
    {
      "name": "pull",
      "description": "查看指定 Pull Request 详情。",
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "number": {
          "type": "number",
          "description": "Issue 或 Pull Request 编号。",
          "required": true
        }
      }
    },
    {
      "name": "create_issue",
      "description": "在指定仓库创建 Issue。",
      "requiresApproval": true,
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "title": {
          "type": "string",
          "description": "Issue 标题。",
          "required": true
        },
        "body": {
          "type": "string",
          "description": "Issue 正文。"
        }
      }
    },
    {
      "name": "comment_issue",
      "description": "评论指定仓库的 Issue 或 Pull Request。",
      "requiresApproval": true,
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "number": {
          "type": "number",
          "description": "Issue 或 Pull Request 编号。",
          "required": true
        },
        "body": {
          "type": "string",
          "description": "评论内容。",
          "required": true
        }
      }
    },
    {
      "name": "create_pull",
      "description": "从已有分支创建 Pull Request。",
      "requiresApproval": true,
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "title": {
          "type": "string",
          "description": "Pull Request 标题。",
          "required": true
        },
        "head": {
          "type": "string",
          "description": "来源分支。",
          "required": true
        },
        "base": {
          "type": "string",
          "description": "目标分支。",
          "required": true
        },
        "body": {
          "type": "string",
          "description": "说明正文。"
        }
      }
    },
    {
      "name": "update_issue",
      "description": "修改 Issue 标题、正文或开关状态。",
      "requiresApproval": true,
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "number": {
          "type": "number",
          "description": "Issue 或 Pull Request 编号。",
          "required": true
        },
        "title": {
          "type": "string",
          "description": "新标题，不修改则不填。"
        },
        "body": {
          "type": "string",
          "description": "新正文，不修改则不填。"
        },
        "state": {
          "type": "string",
          "description": "open 或 closed；不修改则不填。"
        }
      }
    },
    {
      "name": "merge_pull",
      "description": "合并指定 Pull Request。",
      "requiresApproval": true,
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "number": {
          "type": "number",
          "description": "Issue 或 Pull Request 编号。",
          "required": true
        },
        "commit_title": {
          "type": "string",
          "description": "可选的合并提交标题。"
        },
        "merge_method": {
          "type": "string",
          "description": "merge、squash 或 rebase；默认 merge。"
        }
      }
    }
  ]
}
