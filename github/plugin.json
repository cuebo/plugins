{
  "id": "github",
  "name": "GitHub",
  "description": "查看个人概览、贡献日历和仓库概览卡片，以及管理 Issue 与 Pull Request。",
  "pe": "用户要求查看 GitHub 个人主页、贡献或开发者概览时调用 profile_card；要求查看某个仓库的状态、数据或概览时调用 repo_card，并在回答中展示实测卡片。若仓库名不明确，先用 repos 查找。用户要求管理仓库时先读取仓库、Issue 或 Pull Request，再执行写操作。写操作会向用户确认。不要在回答中输出访问令牌。个人概览里的仓库与 Stars 仅统计公开自有仓库，主要语言按公开仓库的主语言统计。仓库概览中的技术栈来自主语言和 package.json 推断，热门标签表示 Stars 不少于 1000。",
  "version": "1.3.1",
  "uiProtocol": "cuebo-v1",
  "capabilities": ["generative_ui"],
  "files": {
    "main.js": ""
  },
  "networkHosts": [
    "api.github.com"
  ],
  "config": [
    {
      "id": "token",
      "title": "GitHub 访问令牌",
      "type": "secret",
      "required": true
    }
  ],
  "tools": [
    {
      "name": "profile_card",
      "description": "查询当前 GitHub 账号，展示个人统计、今年贡献日历与主要语言卡片。",
      "parameters": {}
    },
    {
      "name": "repo_card",
      "description": "查询指定 GitHub 仓库，展示仓库统计、版本信息、最近六周提交活动与可识别技术栈卡片。",
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        }
      }
    },
    {
      "name": "repos",
      "description": "列出当前 GitHub 账号可访问的仓库。",
      "parameters": {
        "page": {
          "type": "number",
          "description": "页码，默认 1。"
        }
      }
    },
    {
      "name": "issues",
      "description": "列出指定仓库的 Issue。",
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "state": {
          "type": "string",
          "description": "open、closed 或 all；默认 open。"
        }
      }
    },
    {
      "name": "issue",
      "description": "查看指定 Issue 详情。",
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "number": {
          "type": "number",
          "description": "Issue 或 Pull Request 编号。",
          "required": true
        }
      }
    },
    {
      "name": "pulls",
      "description": "列出指定仓库的 Pull Request。",
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "state": {
          "type": "string",
          "description": "open、closed 或 all；默认 open。"
        }
      }
    },
    {
      "name": "pull",
      "description": "查看指定 Pull Request 详情。",
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "number": {
          "type": "number",
          "description": "Issue 或 Pull Request 编号。",
          "required": true
        }
      }
    },
    {
      "name": "create_issue",
      "description": "在指定仓库创建 Issue。",
      "requiresApproval": true,
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "title": {
          "type": "string",
          "description": "Issue 标题。",
          "required": true
        },
        "body": {
          "type": "string",
          "description": "Issue 正文。"
        }
      }
    },
    {
      "name": "comment_issue",
      "description": "评论指定仓库的 Issue 或 Pull Request。",
      "requiresApproval": true,
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "number": {
          "type": "number",
          "description": "Issue 或 Pull Request 编号。",
          "required": true
        },
        "body": {
          "type": "string",
          "description": "评论内容。",
          "required": true
        }
      }
    },
    {
      "name": "create_pull",
      "description": "从已有分支创建 Pull Request。",
      "requiresApproval": true,
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "title": {
          "type": "string",
          "description": "Pull Request 标题。",
          "required": true
        },
        "head": {
          "type": "string",
          "description": "来源分支。",
          "required": true
        },
        "base": {
          "type": "string",
          "description": "目标分支。",
          "required": true
        },
        "body": {
          "type": "string",
          "description": "说明正文。"
        }
      }
    },
    {
      "name": "update_issue",
      "description": "修改 Issue 标题、正文或开关状态。",
      "requiresApproval": true,
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "number": {
          "type": "number",
          "description": "Issue 或 Pull Request 编号。",
          "required": true
        },
        "title": {
          "type": "string",
          "description": "新标题，不修改则不填。"
        },
        "body": {
          "type": "string",
          "description": "新正文，不修改则不填。"
        },
        "state": {
          "type": "string",
          "description": "open 或 closed；不修改则不填。"
        }
      }
    },
    {
      "name": "merge_pull",
      "description": "合并指定 Pull Request。",
      "requiresApproval": true,
      "parameters": {
        "owner": {
          "type": "string",
          "description": "仓库所有者或组织名。",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "仓库名。",
          "required": true
        },
        "number": {
          "type": "number",
          "description": "Issue 或 Pull Request 编号。",
          "required": true
        },
        "commit_title": {
          "type": "string",
          "description": "可选的合并提交标题。"
        },
        "merge_method": {
          "type": "string",
          "description": "merge、squash 或 rebase；默认 merge。"
        }
      }
    }
  ]
}
