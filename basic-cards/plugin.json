{
  "id": "basic-cards",
  "name": "基础卡片",
  "description": "在对话中展示五种基础卡片，插件界面展示 35 个组件示例。",
  "pe": "需要用卡片呈现真实的结构化结果时，选择基础卡片插件的对应工具；只传内容数据，不生成布局或动作。工具返回 shown:true 才能说卡片已展示。",
  "version": "1.2.0",
  "ui": true,
  "uiProtocol": "cuebo-v1",
  "files": {
    "main.js": "main.js",
    "scripts/cuebo-ui-demo.js": "scripts/cuebo-ui-demo.js"
  },
  "tools": [
    {
      "name": "show_list",
      "description": "展示可点开的网页链接列表。只传真实的条目标题、说明和 HTTP/HTTPS 地址。",
      "parameters": {
        "items": {
          "type": "array",
          "description": "至少 1 个网页条目",
          "required": true,
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "条目标题",
                "required": true
              },
              "subtitle": {
                "type": "string",
                "description": "条目说明",
                "required": true
              },
              "url": {
                "type": "string",
                "description": "HTTP/HTTPS 网页地址",
                "required": true
              },
              "image_url": {
                "type": "string",
                "description": "可选条目图片地址",
                "required": false
              }
            }
          }
        }
      }
    },
    {
      "name": "show_metrics",
      "description": "展示 1 至 4 项指标。数值保持原文，可附变化文案与 up/down/flat 趋势。",
      "parameters": {
        "items": {
          "type": "array",
          "description": "1 至 4 项指标",
          "required": true,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "指标名称",
                "required": true
              },
              "value": {
                "type": "string",
                "description": "已格式化的数值",
                "required": true
              },
              "change": {
                "type": "string",
                "description": "可选变化文案",
                "required": false
              },
              "trend": {
                "type": "string",
                "description": "有变化文案时填写 up、down 或 flat",
                "required": false
              }
            }
          }
        }
      }
    },
    {
      "name": "show_pie_chart",
      "description": "展示饼图，标题居中放在图下方。输入标题和至少 2 个真实数据点。",
      "parameters": {
        "title": {
          "type": "string",
          "description": "显示在饼图下方的标题，最多 80 字",
          "required": true
        },
        "items": {
          "type": "array",
          "description": "至少 2 个数据点，只传真实数据",
          "required": true,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "项目名称",
                "required": true
              },
              "value": {
                "type": "number",
                "description": "项目数值",
                "required": true
              }
            }
          }
        }
      }
    },
    {
      "name": "show_line_chart",
      "description": "展示折线图，标题居中放在图下方。输入标题和至少 2 个真实数据点。",
      "parameters": {
        "title": {
          "type": "string",
          "description": "显示在折线图下方的标题，最多 80 字",
          "required": true
        },
        "items": {
          "type": "array",
          "description": "至少 2 个数据点，只传真实数据",
          "required": true,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "项目名称",
                "required": true
              },
              "value": {
                "type": "number",
                "description": "项目数值",
                "required": true
              }
            }
          }
        }
      }
    },
    {
      "name": "show_bar_chart",
      "description": "展示柱状图，标题居中放在图下方。输入标题和至少 2 个真实数据点。",
      "parameters": {
        "title": {
          "type": "string",
          "description": "显示在柱状图下方的标题，最多 80 字",
          "required": true
        },
        "items": {
          "type": "array",
          "description": "至少 2 个数据点，只传真实数据",
          "required": true,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "项目名称",
                "required": true
              },
              "value": {
                "type": "number",
                "description": "项目数值",
                "required": true
              }
            }
          }
        }
      }
    }
  ]
}
