{
  "id": "basic-cards",
  "name": "基础卡片",
  "description": "在对话中展示通用信息卡片，支持摘要、资源、趋势、步骤进度与状态。",
  "pe": "基础卡片可用于把真实信息直观展示给用户。遇到会议安排、文件或网页、关键数值、趋势、进度、天气、设备状态等适合卡片的内容时，可调用 plugin_basic_cards_show_cards；按数据选择卡片字段，不要求固定场景或用户说出卡片名称。只传用户提供或工具查到的事实；缺少数据就省略对应字段，不编造图表点、步骤、链接或操作。用户明确只要文字时遵从。工具返回 shown:true 才表示已展示。",
  "version": "1.5.0",
  "ui": true,
  "uiProtocol": "cuebo-v1",
  "files": {
    "main.js": "main.js",
    "scripts/cuebo-ui-demo.js": "scripts/cuebo-ui-demo.js"
  },
  "tools": [
    {
      "name": "show_cards",
      "description": "用统一样式展示 1 至 6 张真实信息卡片。可表达安排、资源、指标趋势、进度、天气、设备状态等场景；只填有据可查的字段，链接仅用于真实网页。",
      "parameters": {
        "cards": {
          "type": "array",
          "description": "1 至 6 张卡片",
          "required": true,
          "items": {
            "type": "object",
            "description": "一张通用卡片，按需要选填内容，不要凑字段",
            "required": false,
            "properties": {
              "title": {
                "type": "string",
                "description": "卡片抬头，例如会议安排、本周数据、设备状态",
                "required": true
              },
              "subtitle": {
                "type": "string",
                "description": "抬头下的时间、对象或来源",
                "required": false
              },
              "icon": {
                "type": "string",
                "description": "可选 SF Symbols 名称，如 calendar、doc.fill、chart.xyaxis.line",
                "required": false
              },
              "accent": {
                "type": "string",
                "description": "blue、green、orange、purple、teal、red 之一",
                "required": false
              },
              "headline": {
                "type": "string",
                "description": "主要信息、数值或状态",
                "required": false
              },
              "detail": {
                "type": "string",
                "description": "主要信息下的补充说明",
                "required": false
              },
              "facts": {
                "type": "array",
                "description": "地点、更新时刻等事实，最多 4 条",
                "required": false,
                "items": {
                  "type": "object",
                  "description": "一条事实或辅助信息",
                  "required": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "description": "真实信息",
                      "required": true
                    },
                    "icon": {
                      "type": "string",
                      "description": "可选 SF Symbols 名称，如 calendar、doc.fill、chart.xyaxis.line",
                      "required": false
                    }
                  }
                }
              },
              "resource": {
                "type": "object",
                "description": "文件、网页或其他资源的摘要",
                "required": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "资源名称",
                    "required": true
                  },
                  "subtitle": {
                    "type": "string",
                    "description": "资源说明",
                    "required": false
                  },
                  "icon": {
                    "type": "string",
                    "description": "可选 SF Symbols 名称，如 calendar、doc.fill、chart.xyaxis.line",
                    "required": false
                  },
                  "url": {
                    "type": "string",
                    "description": "可选的真实 HTTP/HTTPS 链接",
                    "required": false
                  }
                }
              },
              "points": {
                "type": "array",
                "description": "真实且有顺序的趋势数据，至少 2 点，最多 24 点",
                "required": false,
                "items": {
                  "type": "object",
                  "description": "趋势数据点",
                  "required": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "时间或顺序标签",
                      "required": true
                    },
                    "value": {
                      "type": "number",
                      "description": "真实数值",
                      "required": true
                    }
                  }
                }
              },
              "steps": {
                "type": "array",
                "description": "有序进度步骤，2 至 6 个",
                "required": false,
                "items": {
                  "type": "object",
                  "description": "一个进度步骤",
                  "required": false,
                  "properties": {
                    "title": {
                      "type": "string",
                      "description": "步骤名称",
                      "required": true
                    }
                  }
                }
              },
              "current_step": {
                "type": "number",
                "description": "当前步骤的零起始索引；仅在有 steps 时填写",
                "required": false
              },
              "footer": {
                "type": "array",
                "description": "底部简短信息，最多 3 项",
                "required": false,
                "items": {
                  "type": "object",
                  "description": "一条事实或辅助信息",
                  "required": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "description": "真实信息",
                      "required": true
                    },
                    "icon": {
                      "type": "string",
                      "description": "可选 SF Symbols 名称，如 calendar、doc.fill、chart.xyaxis.line",
                      "required": false
                    }
                  }
                }
              },
              "actions": {
                "type": "array",
                "description": "可点击操作，最多 2 项；链接必须真实存在",
                "required": false,
                "items": {
                  "type": "object",
                  "description": "可点击的真实网页操作",
                  "required": false,
                  "properties": {
                    "title": {
                      "type": "string",
                      "description": "操作名称",
                      "required": true
                    },
                    "icon": {
                      "type": "string",
                      "description": "可选 SF Symbols 名称，如 calendar、doc.fill、chart.xyaxis.line",
                      "required": false
                    },
                    "url": {
                      "type": "string",
                      "description": "真实 HTTP/HTTPS 链接",
                      "required": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
