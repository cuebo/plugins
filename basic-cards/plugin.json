{
  "id": "basic-cards",
  "name": "基础卡片",
  "description": "在对话中展示网页列表、指标卡、饼图、折线图和柱状图；插件界面提供组件示例。",
  "pe": "基础卡片已启用。用户要求用卡片、图表或可视化展示数据时，先获取真实数据，再调用对应工具：多个网页链接用 plugin_basic_cards_show_list，1 至 12 个关键数值或状态用 plugin_basic_cards_show_metrics，占比或组成用 plugin_basic_cards_show_pie_chart，时间或顺序趋势用 plugin_basic_cards_show_line_chart，类别数值对比用 plugin_basic_cards_show_bar_chart。用户无需说出插件名称；调用后可补充简短文字解释。只传用户提供或工具查到的数据，不编造。用户明确只要文字时遵从。工具返回 shown:true 才表示界面已展示。",
  "version": "1.2.7",
  "ui": true,
  "uiProtocol": "cuebo-v1",
  "files": {
    "main.js": "main.js",
    "scripts/cuebo-ui-demo.js": "scripts/cuebo-ui-demo.js"
  },
  "tools": [
    {
      "name": "show_list",
      "description": "用户要网页列表、搜索结果或参考资料时，用此工具把多个真实网页链接展示成可点击列表。每项需要标题和 HTTP/HTTPS 地址，说明可选。",
      "parameters": {
        "items": {
          "type": "array",
          "description": "至少 1 个网页条目",
          "required": true,
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "条目标题",
                "required": true
              },
              "subtitle": {
                "type": "string",
                "description": "可选的网页摘要或说明",
                "required": false
              },
              "url": {
                "type": "string",
                "description": "HTTP/HTTPS 网页地址",
                "required": true
              },
              "image_url": {
                "type": "string",
                "description": "可选条目图片地址",
                "required": false
              }
            }
          }
        }
      }
    },
    {
      "name": "show_metrics",
      "description": "用户要关键数据卡片、状态概览或数值对比时，用此工具展示 1 至 12 项指标，每行两张卡片。每项可选 SF Symbols 图标、变化文案和趋势。",
      "parameters": {
        "items": {
          "type": "array",
          "description": "1 至 12 项真实指标，例如 CPU、内存、收入或增长率",
          "required": true,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "指标名称",
                "required": true
              },
              "icon": {
                "type": "string",
                "description": "可选 SF Symbols 图标名称，如 cpu、memorychip、network",
                "required": false
              },
              "value": {
                "type": "string",
                "description": "已格式化的数值",
                "required": true
              },
              "change": {
                "type": "string",
                "description": "可选变化文案",
                "required": false
              },
              "trend": {
                "type": "string",
                "description": "有变化文案时填写 up、down 或 flat",
                "required": false
              }
            }
          }
        }
      }
    },
    {
      "name": "show_pie_chart",
      "description": "用户要看占比、份额或组成时，用此工具展示饼图。至少传 2 个真实的正数数据点，并给图表标题。",
      "parameters": {
        "title": {
          "type": "string",
          "description": "显示在饼图下方的标题，最多 80 字",
          "required": true
        },
        "items": {
          "type": "array",
          "description": "至少 2 个数据点，只传真实数据",
          "required": true,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "项目名称",
                "required": true
              },
              "value": {
                "type": "number",
                "description": "项目数值",
                "required": true
              }
            }
          }
        }
      }
    },
    {
      "name": "show_line_chart",
      "description": "用户要看随时间或顺序变化的趋势时，用此工具展示折线图。至少传 2 个按顺序排列的真实数据点；更多数据可左右滑动查看。",
      "parameters": {
        "title": {
          "type": "string",
          "description": "显示在折线图下方的标题，最多 80 字",
          "required": true
        },
        "items": {
          "type": "array",
          "description": "至少 2 个数据点，只传真实数据",
          "required": true,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "项目名称",
                "required": true
              },
              "value": {
                "type": "number",
                "description": "项目数值",
                "required": true
              }
            }
          }
        }
      }
    },
    {
      "name": "show_bar_chart",
      "description": "用户要比较多个类别、项目或时段的数值时，用此工具展示柱状图。至少传 2 个真实数据点；更多数据可左右滑动查看。",
      "parameters": {
        "title": {
          "type": "string",
          "description": "显示在柱状图下方的标题，最多 80 字",
          "required": true
        },
        "items": {
          "type": "array",
          "description": "至少 2 个数据点，只传真实数据",
          "required": true,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "项目名称",
                "required": true
              },
              "value": {
                "type": "number",
                "description": "项目数值",
                "required": true
              }
            }
          }
        }
      }
    }
  ]
}
